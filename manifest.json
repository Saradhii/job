{
  "manifest_version": 3,
  "name": "Job Auto-Filler",
  "version": "0.1.0",
  "description": "Detect job application form fields and pre-fill them from your profile.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Job Auto-Filler"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
