{
  "manifest_version": 3,
  "name": "Job Auto-Filler",
  "version": "0.1.0",
  "description": "Detect job application form fields and pre-fill them from your profile.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Job Auto-Filler", "default_popup": "popup/popup.html" },
  "background": { "service_worker": "background.js" },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/profile.js",
        "src/fields.js",
        "src/match.js",
        "src/llm.js",
        "src/storage.js",
        "src/fill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
